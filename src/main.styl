html
  font-family: Georgia, serif
  font-size: 20px
  line-height: 1.4rem
  background-color: #003409
  
a
  transition: color 250ms
  &:active, &:link
    color: #003409
  &:visited, &:hover
    color: black
  
.container
  max-width: 880px
  margin: 0 auto
  padding: 2rem
  background-color: white
  
h1, h2, h3
  line-height: 1.2
  text-wrap: balance

h1
  margin-top: 0
  
h3
  font-family: sans-serif

p
  text-wrap: pretty
  
figure
  margin: 0
  
figcaption
  font-size: .6rem  
  
img
  max-width: 100%
  height: auto
  
#mc_embed_signup
  clear: left
  
#mc_embed_signup form
  padding: 0 !important
  
#mc_embed_signup .button
  font-size: 20px !important
  
@media only screen and (max-width: 700px)
  html
    font-size: 16px

  body
    margin: 12px

  .container
    padding: 1rem

@media only screen and (max-width: 400px)
  .container
    padding: 0.75rem
    
  #mc_embed_signup .button
    font-size: 16px !important